# 开发环境配置（docker-compose.dev.yml 与本地后端共用）
# 复制为 .env.dev 后按需修改：cp .env.dev.example .env.dev
# 注意：本地运行后端时 POSTGRES_HOST/REDIS_HOST/OSS_HOST 需指向 localhost；
# compose 内部的 oss-init 会自行覆盖为容器服务名。

# 数据库
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin2025
POSTGRES_DB=do-exercise
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# 对象存储（引擎为 RustFS；root 凭证由 compose 映射为容器边界 RUSTFS_* 变量）
# root 账号需 >=5 位，密码 >=8 位；勿用公开默认值 rustfsadmin
OSS_ROOT_ACCESS_KEY=minioadmin
OSS_ROOT_SECRET_KEY=minioadmin2025
# 节点间 RPC 认证密钥（强随机且 ≠ OSS_ROOT_SECRET_KEY，见 docs/minio-to-rustfs-migration.md R6）
OSS_RPC_SECRET=dev-oss-rpc-secret-please-change-0123456789abcdef
# 本地服务访问对象存储的地址（容器内初始化由 compose 覆盖为 oss）
OSS_HOST=localhost
OSS_PORT=9000
# 自动创建的 bucket 名称
OSS_BUCKET_NAME=do-exercise
# server 上传文件使用的 Access Key / Secret Key
OSS_APP_ACCESS_KEY=nDa0QksTxwKRGbR0X9gP
OSS_APP_SECRET_KEY=sGkiVDvE5zTsfQyAONpKd60OCyzaoRoKoAjIbDop
# 浏览器访问对象存储的公开地址（本地为 http://localhost:9000，生产走 nginx 反代路径如 /oss）
OSS_PRESIGNED_HOST=http://localhost:9000

# 邮箱（找回密码、邮箱登录验证码的投递通道）
# 通过环境变量注入，不要写进 server/config.yaml——该文件会被打进镜像层
EMAIL_HOST=smtp.qq.com
EMAIL_PORT=587
EMAIL_USER=xxxxxx@example.com
EMAIL_PASS=REDACTED-ROTATED-CREDENTIAL