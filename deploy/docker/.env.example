# 数据库
# 如果是docker为docker容器名称
POSTGRES_HOST=postgres
# 数据库端口
POSTGRES_PORT=5432
# 数据库用户
POSTGRES_USER=xxxxx
# 数据库密码
POSTGRES_PASSWORD=xxxxxxxxxxx
# 数据库名称
POSTGRES_DB=xxxxxx
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public"
# minio
# 账号需大于等于5位
MINIO_ROOT_USER=xxxxx
# 账号需大于等于8位
MINIO_ROOT_PASSWORD=xxxxxxxx
# MinIO Docker 网络内地址
MINIO_HOST=minio
MINIO_PORT=9000
# 存储桶名称
MINIO_BUCKET_NAME=do-exercise
MINIO_APP_ACCESS_KEY=xxxxxxxx
MINIO_APP_SECRET_KEY=xxxxxxxx
# 浏览器访问 MinIO 的公开反代路径
MINIO_PRESIGNED_HOST=/oss

# 邮箱（找回密码、邮箱登录验证码的投递通道）
# 通过环境变量注入，不要写进 server/config.yaml——该文件会被打进镜像层
EMAIL_HOST=smtp.qq.com
EMAIL_PORT=587
EMAIL_USER=xxxxxx@example.com
EMAIL_PASS=xxxxxxxx
