# 数据库
# 构建时的 Go 依赖源；默认源不可达时可设置 https://goproxy.cn,direct。
GOPROXY=https://proxy.golang.org,direct
# 如果是docker为docker容器名称
POSTGRES_HOST=postgres
# 数据库端口
POSTGRES_PORT=5432
# 数据库用户
POSTGRES_USER=xxxxx
# 数据库密码
POSTGRES_PASSWORD=xxxxxxxxxxx
# 数据库名称
POSTGRES_DB=xxxxxx
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public"
# 对象存储（引擎为 RustFS，root 凭证会由 compose 映射为容器边界 RUSTFS_* 变量）
# root 账号需大于等于5位，且不要用公开默认值 rustfsadmin
OSS_ROOT_ACCESS_KEY=xxxxx
# root 密码需大于等于8位
OSS_ROOT_SECRET_KEY=xxxxxxxx
# 节点间 RPC 认证密钥（强随机且与 OSS_ROOT_SECRET_KEY 不同）
OSS_RPC_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 对象存储 Docker 网络内地址
OSS_HOST=oss
OSS_PORT=9000
# 存储桶名称
OSS_BUCKET_NAME=do-exercise
# 应用专用凭证：Access Key 3–128 字节，Secret Key 8–40 字节，建议使用 32 字符随机值。
OSS_APP_ACCESS_KEY=xxxxxxxx
OSS_APP_SECRET_KEY=xxxxxxxx
# 浏览器访问对象存储的公开反代路径
OSS_PRESIGNED_HOST=/oss

# 邮箱（找回密码、邮箱登录验证码的投递通道）
# 通过环境变量注入，不要写进 server/config.yaml——该文件会被打进镜像层
EMAIL_HOST=smtp.qq.com
EMAIL_PORT=587
EMAIL_USER=xxxxxx@example.com
EMAIL_PASS=xxxxxxxx
# 初始用户名 superAdmin，登录时租户编码留空。
# 首次迁移需要唯一的 12–72 字节管理员密码，包含大小写字母、数字和符号。
BOOTSTRAP_ADMIN_PASSWORD=
REDIS_HOST=redis
REDIS_PORT=6379
# Compose 同时将此密码用于 Redis 服务和后端；生产环境请设置强随机值。
REDIS_PASSWORD=
REDIS_DATABASE=0
