{
  "name": "shadcn-web",
  "description": "A built with Vite, React, and Tailwind CSS.",
  "private": false,
  "version": "1.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "knip": "knip",
    "gen:apis": "openapi-generator-cli generate -g typescript-fetch -c ./openapi-generator.config.yaml -o ./src/do-exercise-api -i ../server/openapi.yaml && node ./scripts/fix-generated-files.cjs",
    "test": "vitest",
    "coverage": "vitest run --coverage"
  },
